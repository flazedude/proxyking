{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProxyKing",
  "version": "0.3.3",
  "identifier": "app.proxyking.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ProxyKing",
        "width": 1220,
        "height": 860,
        "minWidth": 850,
        "minHeight": 640,
        "backgroundColor": "#f5f6f2"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "shortDescription": "Your network. Your rules.",
    "category": "Utility",
    "resources": {
      "resources/sing-box.exe": "resources/sing-box.exe",
      "resources/sing-box-LICENSE.txt": "resources/sing-box-LICENSE.txt",
      "resources/GPL-3.0.txt": "resources/GPL-3.0.txt",
      "../THIRD_PARTY_NOTICES.md": "resources/THIRD_PARTY_NOTICES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "dangerousInsecureTransportProtocol": true,
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEzRTQwQTUyQzJCMzk4NzAKUldSd21MUENVZ3Jrb3hFdFFTUUZBMHZ1QkRPSU16R3hFdjlRYkJIek1TTWpVYVY5dWd1L09qTVcK",
      "endpoints": [
        "http://192.168.2.76:17845/proxyking/latest.json",
        "http://192.168.2.59:17845/proxyking/latest.json",
        "https://github.com/flazedude/proxyking/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
